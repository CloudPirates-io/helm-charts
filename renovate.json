{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "custom.regex",
    "helmv3"
  ],
  "separateMinorPatch": true,
  "prConcurrentLimit": 5,
  "recreateWhen": "never",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Match Docker images in all charts",
      "managerFilePatterns": [
        "/(^|/)charts/.+/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:## @param \\S+\\.registry .+?\\n\\s+registry:\\s*(?<registryValue>[^\\s]+)\\n\\s+)?## @param (?<depName>\\S+\\.repository) .+?\\n\\s+repository:\\s*(?<repositoryValue>[^\\s]+)\\n\\s+## @param \\S+\\.tag .+?\\n\\s+tag:\\s*['\"]?(?<currentValue>[^@'\"\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "packageNameTemplate": "{{#if registryValue}}{{{registryValue}}}/{{{repositoryValue}}}{{else}}{{{repositoryValue}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Use ghcr.io registry for the RabbitMQ operator images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "rabbitmq/cluster-operator",
        "rabbitmq/messaging-topology-operator",
        "rabbitmq/default-user-credential-updater"
      ],
      "registryUrls": [
        "https://ghcr.io"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "labels": [
        "dependencies",
        "renovate"
      ],
      "commitMessageTopic": "{{{depName}}}",
      "commitMessagePrefix": "[{{{replace 'docker.io/' '' packageName}}}]",
      "automerge": false,
      "separateMinorPatch": true
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "labels": [
        "dependencies",
        "renovate"
      ],
      "automerge": false,
      "commitMessagePrefix": "[helm]"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "koperator-internal/services/clusterpirate"
      ],
      "enabled": false,
      "pinDigests": false,
      "recreateWhen": "never"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "cloudpirates/common",
        "cloudpirates/valkey"
      ],
      "enabled": false,
      "recreateWhen": "never"
    },
    {
      "description": "Configure etcd image updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "gcr.io/etcd-development/etcd"
      ],
      "labels": [
        "dependencies",
        "renovate"
      ],
      "commitMessagePrefix": "[etcd]",
      "automerge": false,
      "separateMinorPatch": true
    }
  ]
}